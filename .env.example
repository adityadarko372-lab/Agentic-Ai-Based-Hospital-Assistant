# Nova Health configuration. Copy to `.env` and adjust if needed.
# `.env` is gitignored; never commit real secrets.

# demo | development | test
ENVIRONMENT=demo

# Browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Secret that signs login session tokens. Leave empty here:
# scripts\setup.ps1 / scripts\start.ps1 generate a random value in `.env`.
SESSION_SECRET=
# How long a demo login lasts, in hours.
SESSION_HOURS=8

# Optional: custom SQLite file location (default: backend/data/nova_health.db)
# DATABASE_PATH=

# ---- Optional enhancements (Phase 5). All OFF by default. ----
# Each one falls back safely if its model or service is missing; the
# dashboard and the Agent Activity panel say what is really running.
# See docs/setup.md, "Optional Phase 5 features", for the install steps.

# Intent routing: "rules" (default, transparent) or "transformer"
# (fine-tuned DistilBERT + rules hybrid; needs model/artifacts/intent_classifier)
INTENT_CLASSIFIER=rules

# General health information from NIH MedQuAD (needs model/artifacts/health_info)
HEALTH_INFO_ENABLED=false
# Minimum similarity for showing a MedQuAD passage (chosen on the evaluation set)
# HEALTH_INFO_MIN_SCORE=0.55

# Local Ollama rewording of some replies (needs Ollama + scripts\setup-ollama.ps1)
LLM_PHRASING_ENABLED=false
# Only local addresses are accepted.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# LLM_TIMEOUT_SECONDS=8

# Front-desk review page (staff account frontdesk@novahealth.demo)
FRONT_DESK_ENABLED=false
