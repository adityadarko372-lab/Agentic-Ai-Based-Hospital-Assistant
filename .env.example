# Nova Health configuration. Copy to `.env` and adjust if needed.
# `.env` is gitignored; never commit real secrets.

# demo | development | test
ENVIRONMENT=demo

# Browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Secret that signs login session tokens. Leave empty here:
# scripts\setup.ps1 / scripts\start.ps1 generate a random value in `.env`.
SESSION_SECRET=
# How long a demo login lasts, in hours.
SESSION_HOURS=8

# Optional: custom SQLite file location (default: backend/data/nova_health.db)
# DATABASE_PATH=

# ---- Optional enhancements (Phase 5). All OFF by default. ----
# Intent routing: "rules" (default, transparent) or "transformer" (optional trained model)
INTENT_CLASSIFIER=rules
# MedQuAD general health information retrieval
HEALTH_INFO_ENABLED=false
# Local Ollama rewording of agent answers
LLM_PHRASING_ENABLED=false
# Front-desk review page for appointment requests
FRONT_DESK_ENABLED=false
